# Auto detect text files and perform LF normalization
* text=auto
# Paparazzi snapshot images - treat as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
# Gradle wrapper
gradlew text eol=lf
gradlew.bat text eol=crlf
# Shell scripts
*.sh text eol=lf
# Kotlin/Java files
*.kt text diff=kotlin
*.java text diff=java
*.kts text diff=kotlin
# XML files
*.xml text
# Properties files
*.properties text
# Markdown
*.md text diff=markdown
